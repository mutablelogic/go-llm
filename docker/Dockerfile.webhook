# syntax=docker/dockerfile:1
ARG OS=linux
ARG ARCH=amd64
ARG GO_VERSION=1.27

# Build the webhook command on the Go image, without cgo, so it's static,
# with its webhooks in a SQLite database. It has no web UI, so it doesn't
# need Node.
FROM --platform=${OS}/${ARCH} golang:${GO_VERSION}-trixie AS builder
ARG OS
ARG ARCH
WORKDIR /usr/src/app

# Download the modules first, so they're only downloaded again when they
# change
COPY go.mod go.sum ./
RUN go mod download

# Build the command
COPY . .
RUN set -x \
    && OS=${OS} ARCH=${ARCH} CGO_ENABLED=0 make webhook WEBHOOK_BACKEND=sqlite \
    && install -m 0755 docker/entrypoint-webhook.sh build/entrypoint.sh

# Copy the command to /usr/local/bin, on Debian, with the CA certificates,
# and gosu, which the entrypoint drops privileges with, to the webhook user,
# which the server runs as
FROM --platform=${OS}/${ARCH} debian:trixie-slim
ARG SOURCE
RUN set -x && apt-get update -y \
    && apt-get install -y --no-install-recommends ca-certificates gosu \
    && groupadd --system webhook \
    && useradd --system --gid webhook --no-create-home --shell /usr/sbin/nologin webhook \
    && install -d -o webhook -g webhook /data \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/src/app/build/webhook /usr/src/app/build/entrypoint.sh /usr/local/bin/

# Check the command runs
RUN /usr/local/bin/webhook --version

# Label the image
LABEL org.opencontainers.image.source=${SOURCE}

# The server keeps its webhooks, and their calls, in a SQLite database in
# /data/webhook, which is its data directory, as the webhook user has no
# home directory, for ~/.local/share
ENV XDG_CACHE_HOME=/data XDG_DATA_HOME=/data

# The server listens on every interface in the container. Its API, which
# creates webhooks, and lists their calls, has no authentication yet, so
# only the URL which services call, /api/hook/, should be reachable from the
# internet, such as through a proxy, and the rest only from where it's
# trusted.
ENV ADDR=0.0.0.0:8084
VOLUME /data
EXPOSE 8084
STOPSIGNAL SIGTERM

# Entrypoint runs as root, optionally remaps the webhook user's UID and GID,
# makes /data the webhook user's, then drops to the webhook user before
# exec-ing webhook
ENTRYPOINT [ "/usr/local/bin/entrypoint.sh" ]
